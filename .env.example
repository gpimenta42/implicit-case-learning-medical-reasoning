# Copy this file to `.env` and fill in local credentials.
# Do not commit `.env`; it is intentionally ignored by git.

# Required for the default notebook example:
OPENAI_API_KEY=

# Optional OpenAI example settings:
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=medium
ICL_EDR_EMBEDDING_MODEL=text-embedding-3-large

# Optional Hugging Face Inference Provider settings:
HF_TOKEN=
